# Copy this file to .env and fill in your key.
# Used by the browser (runtime card generation) — key is visible in the bundle,
# so this setup is suitable for personal/local use only.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Used by the pre-generation script (Node.js, never sent to browser):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
